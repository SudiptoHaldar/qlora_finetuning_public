# Copy this file to .env and adjust values. .env is git-ignored; never commit it.
# AWS credentials do not go here: they stay in the AWS CLI profile (docs/runbook.md).

# Logging verbosity for qlora_finetuning components (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# The folder of the public copy of this repository (python -m scripts.public_export).
# A full path outside this repository. Leave it out to name the folder with --to.
# QLORA_PUBLIC_EXPORT_DIR=

# Hugging Face write token, for publishing the two model packages (req_006 v6.03).
# Create it at huggingface.co, Settings, Access Tokens, with write access to your own
# repositories. Put the value in .env only: never here, never in a command, never in a commit.
HF_TOKEN=
